# =========================================================
# CONTOH file .env untuk Asisten Belajar (DeepSeek)
#
# Cara pakai:
#   1. Salin file ini dan beri nama:  .env
#   2. Isi DEEPSEEK_API_KEY dengan API Key dari https://platform.deepseek.com
#   3. Jangan upload file .env ke GitHub (sudah otomatis diabaikan oleh .gitignore)
#
# Di hosting (misalnya Render), isi nilai yang sama lewat menu
# "Environment Variables", bukan dengan meng-upload file ini.
# =========================================================

# API Key DeepSeek (diawali sk-...). WAJIB diisi.
DEEPSEEK_API_KEY=

# Model DeepSeek yang dipakai (biarkan saja kalau tidak yakin)
DEEPSEEK_MODEL=deepseek-chat

# Alamat web GitHub Pages yang boleh memakai asisten ini, dipisah koma
# (tanpa garis miring di akhir). Laptop (127.0.0.1:5000) selalu diizinkan.
IZIN_ASAL=https://USERNAME.github.io
